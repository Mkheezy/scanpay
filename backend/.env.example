# Copy to .env. Load with node --env-file=.env --import tsx src/server.ts
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
# Default is persistent embedded PostgreSQL. One process only.
DATA_DIR=.data/groundwork
# Set this to use a regular PostgreSQL server instead:
# DATABASE_URL=postgresql://groundwork:change-me@127.0.0.1:5432/groundwork
PAYMENT_PROVIDER=mock
POS_PROVIDER=mock
DEMO_MODE=true
# Required when listening beyond loopback; use a long random value.
DEMO_ACCESS_KEY=
# Test mode only. Live keys are rejected.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_SIGNATURE_MODE=timestamped
