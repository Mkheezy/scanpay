    "/payments": {
      "post": {
        "summary": "Reserve a share and initialize checkout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Groundwork",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]{8,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "full",
                      "equal",
                      "custom"
                    ]
                  },
                  "amountCents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000
                  },
                  "people": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 12
                  },
                  "tipPercent": {
                    "enum": [
                      0,
                      10,
                      12,
                      15
                    ]
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "mode",
                  "tipPercent",
                  "revision"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful sandbox operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing session or signature"
          },
          "403": {
            "description": "Scope, role, origin or capability denied"
          },
          "409": {
            "description": "Conflicting request or stale state"
          },
          "503": {
            "description": "Integration not configured"
          }
        }
      }
    },
